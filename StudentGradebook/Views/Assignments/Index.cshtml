@model IEnumerable<StudentGradebook.Models.Assignment>

@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Assignments</h1>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Course</th>
                    <th>Assignment</th>
                    <th>Type</th>
                    <th>Max Points</th>
                    <th>Weight</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Course.CourseCode</strong><br />
                            <small class="text-muted">@item.Course.Name</small>
                        </td>
                        <td>@item.Title</td>
                        <td>
                            <span class="badge bg-info">@item.Type</span>
                        </td>
                        <td>@item.MaxPoints</td>
                        <td>@item.Weight%</td>
                        <td>@item.DueDate.ToString("MM/dd/yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="EnterGrades" asp-route-id="@item.Id" class="btn btn-sm btn-success">Enter Grades</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>