@model StudentGradebook.Controllers.AssignmentsController.EnterGradesViewModel

@{
    ViewData["Title"] = "Enter Grades";
}

<h1>Enter Grades for @Model.Assignment.Title</h1>
<h5 class="text-muted">@Model.Assignment.Course.CourseCode - @Model.Assignment.Course.Name</h5>

<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            Assignment Details
        </h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Max Points:</dt>
            <dd class="col-sm-4">@Model.Assignment.MaxPoints</dd>
            <dt class="col-sm-2">Due Date:</dt>
            <dd class="col-sm-4">@Model.Assignment.DueDate.ToString("MM/dd/yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="EnterGrades" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Assignment.Id" />

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Student Grades</h5>
        </div>
        <div class="card-body">
            @if (Model.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Points Earned</th>
                                <th>Percentage</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                var existingGrade = Model.ExistingGrades.ContainsKey(student.Id) ? Model.ExistingGrades[student.Id] : null;
                                var pointsEarned = existingGrade?.PointsEarned ?? 0;
                                var percentage = Model.Assignment.MaxPoints > 0 ? (pointsEarned / Model.Assignment.MaxPoints) * 100 : 0;

                                <tr>
                                    <td>
                                        <strong>@student.FullName</strong><br />
                                        <small class="text-muted">@student.StudentId</small>
                                    </td>
                                    <td style="width: 200px;">
                                        <input type="number"
                                               name="grades[@student.Id]"
                                               value="@pointsEarned"
                                               min="0"
                                               max="@Model.Assignment.MaxPoints"
                                               step="0.5"
                                               class="form-control form-control-sm"
                                               onchange="updatePercentage(this, @Model.Assignment.MaxPoints)" />
                                    </td>
                                    <td>
                                        <span id="percentage-@student.Id" class="badge
                                                    @(percentage >= 70 ? "bg-success" :
                                                                                                                        percentage >= 60 ? "bg-warning" : "bg-danger")">
                                    @percentage.ToString("F1")%
                                </span>
                            </td>
                            <td>
                                <input type="text"
                                       name="notes[@student.Id]"
                                       value="@existingGrade?.Notes"
                                       class="form-control form-control-sm"
                                       placeholder="Optional notes" />
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save All Grades</button>
                    <a asp-action="Details" asp-route-id="@Model.Assignment.Id" class="btn btn-secondary">Cancel</a>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <h5>No enrolled students found!</h5>
                    <p>There are no students currently enrolled in this course. Please enroll students before entering grades.</p>
                    <a asp-controller="Enrollments" asp-action="Create" class="btn btn-primary">Enroll Students</a>
                </div>
            }
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function updatePercentage(input, maxPoints) {
            const points = parseFloat(input.value) || 0;
            const percentage = maxPoints > 0 ? (points / maxPoints) * 100 : 0;
            const studentId = input.name.match(/\[(\d+)\]/)[1];
            const badge = document.getElementById('percentage-' + studentId);

            badge.textContent = percentage.toFixed(1) + '%';

            // Update badge color based on percentage
            if (percentage >= 70) {
                badge.className = 'badge bg-success';
            } else if (percentage >= 60) {
                badge.className = 'badge bg-warning';
            } else {
                badge.className = 'badge bg-danger';
            }
        }

        // Initialize percentages on page load
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('input[type="number"]');
            inputs.forEach(input => {
                updatePercentage(input, @Model.Assignment.MaxPoints);
            });
        });
    </script>
}