@model StudentGradebook.Models.Assignment

@{
    ViewData["Title"] = "Delete Assignment";
}

<h1>Delete Assignment</h1>

<h3>Are you sure you want to delete this assignment?</h3>
<div class="card mt-4">
    <div class="card-body">
        <h4 class="text-danger">Warning: This will also delete all grades associated with this assignment!</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Course:</dt>
            <dd class="col-sm-9">@Model.Course.CourseCode - @Model.Course.Name</dd>

            <dt class="col-sm-3">Title:</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Type:</dt>
            <dd class="col-sm-9">
                <span class="badge bg-info">@Model.Type</span>
            </dd>

            <dt class="col-sm-3">Max Points:</dt>
            <dd class="col-sm-9">@Model.MaxPoints</dd>

            <dt class="col-sm-3">Weight:</dt>
            <dd class="col-sm-9">@Model.Weight%</dd>

            <dt class="col-sm-3">Due Date:</dt>
            <dd class="col-sm-9">@Model.DueDate.ToString("MM/dd/yyyy")</dd>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete Assignment</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>