@model StudentGradebook.Models.Assignment
@using StudentGradebook.Models

@{
    ViewData["Title"] = "Assignment Details";
    var grades = ViewBag.Grades as List<Grade> ?? new List<Grade>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Assignment Details</h1>
    <div>
        <a asp-action="EnterGrades" asp-route-id="@Model.Id" class="btn btn-success">Enter Grades</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Assignment Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Course:</dt>
                    <dd class="col-sm-8">@Model.Course.CourseCode - @Model.Course.Name</dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8">@Model.Title</dd>

                    <dt class="col-sm-4">Description:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</dd>

                    <dt class="col-sm-4">Type:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@Model.Type</span>
                    </dd>

                    <dt class="col-sm-4">Max Points:</dt>
                    <dd class="col-sm-8">@Model.MaxPoints</dd>

                    <dt class="col-sm-4">Weight:</dt>
                    <dd class="col-sm-8">@Model.Weight%</dd>

                    <dt class="col-sm-4">Due Date:</dt>
                    <dd class="col-sm-8">@Model.DueDate.ToString("MM/dd/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Grade Summary</h5>
            </div>
            <div class="card-body">
                @if (grades.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Points</th>
                                    <th>Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grade in grades)
                                {
                                    <tr>
                                        <td>@grade.Student.FullName</td>
                                        <td>@grade.PointsEarned / @Model.MaxPoints</td>
                                        <td>
                                            <span class="badge @(grade.Percentage >= 70 ? "bg-success" : "bg-warning")">
                                                @grade.Percentage.ToString("F1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                        <strong>Average: </strong>
                        @{
                            var average = grades.Average(g => g.Percentage);
                            <span class="badge @(average >= 70 ? "bg-success" : "bg-warning")">
                                @average.ToString("F1")%
                            </span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No grades have been entered for this assignment yet.</p>
                    <a asp-action="EnterGrades" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Enter Grades</a>
                }
            </div>
        </div>
    </div>
</div>