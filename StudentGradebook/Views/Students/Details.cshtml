@model StudentGradebook.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Student Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student ID:</dt>
            <dd class="col-sm-9">@Model.StudentId</dd>

            <dt class="col-sm-3">First Name:</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Last Name:</dt>
            <dd class="col-sm-9">@Model.LastName</dd>

            <dt class="col-sm-3">Email:</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "No email" : Model.Email)</dd>

            <dt class="col-sm-3">Phone:</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Phone) ? "No phone" : Model.Phone)</dd>

            <!-- Add these after the Phone field -->
            <dt class="col-sm-3">Birth Date:</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToString("MM/dd/yyyy")</dd>

            <dt class="col-sm-3">Age:</dt>
            <dd class="col-sm-9">@Model.Age years old</dd>

            <dt class="col-sm-3">Enrollment Date:</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToString("MM/dd/yyyy")</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <h4>Course Enrollments</h4>
    <a asp-controller="Enrollments" asp-action="ByStudent" asp-route-id="@Model.Id"
       class="btn btn-outline-primary btn-sm">View Enrollments</a>
</div>