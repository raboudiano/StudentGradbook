@model StudentGradebook.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete Student</h1>

<h3>Are you sure you want to delete this student?</h3>
<div class="card mt-4">
    <div class="card-body">
        <h4 class="text-danger">This action will deactivate the student. They will not be permanently deleted.</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Student ID:</dt>
            <dd class="col-sm-9">@Model.StudentId</dd>

            <dt class="col-sm-3">Name:</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email:</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "No email" : Model.Email)</dd>

            <dt class="col-sm-3">Enrollment Date:</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToString("MM/dd/yyyy")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Deactivate Student</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>