@model StudentGradebook.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

<h3>Are you sure you want to delete this course?</h3>
<div class="card mt-4">
    <div class="card-body">
        <h4 class="text-danger">This action will deactivate the course. It will not be permanently deleted.</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Course Code:</dt>
            <dd class="col-sm-9">@Model.CourseCode</dd>

            <dt class="col-sm-3">Course Name:</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Credits:</dt>
            <dd class="col-sm-9">@Model.Credits</dd>

            <dt class="col-sm-3">Semester:</dt>
            <dd class="col-sm-9">@Model.Semester</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Deactivate Course</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>