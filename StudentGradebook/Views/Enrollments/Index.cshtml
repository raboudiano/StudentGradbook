@model IEnumerable<StudentGradebook.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Enrollments</h1>
    <a asp-action="Create" class="btn btn-primary">Enroll Student</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h4>No Enrollments Found</h4>
        <p>No students are enrolled in any courses yet.</p>
        <a asp-action="Create" class="btn btn-primary">Enroll First Student</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Total Enrollments: @Model.Count()</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Student</th>
                        <th>Student ID</th>
                        <th>Course</th>
                        <th>Enrollment Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Student.FullName</td>
                            <td>@item.Student.StudentId</td>
                            <td>
                                <strong>@item.Course.CourseCode</strong><br />
                                <small class="text-muted">@item.Course.Name</small>
                            </td>
                            <td>@item.EnrollmentDate.ToString("MM/dd/yyyy")</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                @if (item.Status == EnrollmentStatus.Enrolled)
                                {
                                    <form asp-action="Drop" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to drop this student from the course?')">
                                            Drop
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    public string GetStatusBadgeClass(EnrollmentStatus status)
    {
        return status switch
        {
            EnrollmentStatus.Enrolled => "bg-success",
            EnrollmentStatus.Completed => "bg-primary",
            EnrollmentStatus.Dropped => "bg-danger",
            EnrollmentStatus.Withdrawn => "bg-warning",
            _ => "bg-secondary"
        };
    }
}