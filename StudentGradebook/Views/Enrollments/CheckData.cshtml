@{
    ViewData["Title"] = "Check Data";
}

<h1>Data Check</h1>

<div class="row">
    <div class="col-md-6">
        <h3>Students: @ViewBag.StudentCount</h3>
        <ul>
            @foreach (var student in ViewBag.Students)
            {
                <li>@student.Id - @student.FullName (ID: @student.StudentId)</li>
            }
        </ul>
    </div>
    <div class="col-md-6">
        <h3>Courses: @ViewBag.CourseCount</h3>
        <ul>
            @foreach (var course in ViewBag.Courses)
            {
                <li>@course.Id - @course.CourseCode: @course.Name</li>
            }
        </ul>
    </div>
</div>

<a asp-action="Create" class="btn btn-primary">Try Enrollment Again</a>