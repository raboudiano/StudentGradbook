@model StudentGradebook.Models.Enrollment

@{
    ViewData["Title"] = "Test Enrollment";
}

<h1>Test Enrollment (Simplified)</h1>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Student ID (number):</label>
        <input type="number" name="StudentId" class="form-control" value="1" />
    </div>

    <div class="form-group">
        <label>Course ID (number):</label>
        <input type="number" name="CourseId" class="form-control" value="1" />
    </div>

    <div class="form-group">
        <label>Status:</label>
        <select name="Status" class="form-control">
            <option value="0">Enrolled</option>
            <option value="1">Completed</option>
            <option value="2">Dropped</option>
            <option value="3">Withdrawn</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create Enrollment</button>
</form>