@model IEnumerable<StudentGradebook.Models.Enrollment>
@{
    var student = ViewBag.Student as StudentGradebook.Models.Student;
    ViewData["Title"] = $"Enrollments for {student?.FullName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Enrollments for @student?.FullName</h1>
    <div>
        <a asp-controller="Students" asp-action="Details" asp-route-id="@student?.Id" class="btn btn-secondary">Back to Student</a>
        <a asp-controller="Enrollments" asp-action="Create" class="btn btn-primary">Enroll in New Course</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h4>No Enrollments Found</h4>
        <p>This student is not enrolled in any courses yet.</p>
        <a asp-controller="Enrollments" asp-action="Create" class="btn btn-primary">Enroll in a Course</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Course Code</th>
                        <th>Enrollment Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Course.Name</td>
                            <td>@item.Course.CourseCode</td>
                            <td>@item.EnrollmentDate.ToString("MM/dd/yyyy")</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId"
                                   class="btn btn-sm btn-info">Course Details</a>
                                @if (item.Status == EnrollmentStatus.Enrolled)
                                {
                                    <form asp-action="Drop" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to drop this course?')">
                                            Drop Course
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    public string GetStatusBadgeClass(EnrollmentStatus status)
    {
        return status switch
        {
            EnrollmentStatus.Enrolled => "bg-success",
            EnrollmentStatus.Completed => "bg-primary",
            EnrollmentStatus.Dropped => "bg-danger",
            EnrollmentStatus.Withdrawn => "bg-warning",
            _ => "bg-secondary"
        };
    }
}